    "next-mdx-remote": "5.0.0",
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "tailwindcss": "3.4.7",
    "@tailwindcss/typography": "0.5.13",
    "postcss": "8.4.40",
    "autoprefixer": "10.4.19"
  }
}
