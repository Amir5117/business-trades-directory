# Copy to .env.local for the migration scripts. Never commit .env.local.

# --- Public site identity (used by Next.js + parity map) ---
NEXT_PUBLIC_SITE_NAME="TheBusinessTrades"
NEXT_PUBLIC_SITE_URL="https://thebusinesstrades.com"
NEXT_PUBLIC_GA_ID=""               # NEW GA4 property for TheBusinessTrades (do NOT reuse G-E6WGTM90D5)

# --- Legacy source (READ-ONLY). Relative to scripts/ working dir. ---
LEGACY_ROOT="../legacy-wp-data/wpress-extract"
LEGACY_OLD_DOMAIN="https://idealonlinebusiness.com"

# --- MySQL read-only connection (Option A). Leave blank to use --source sqldump. ---
WP_DB_HOST="127.0.0.1"
WP_DB_PORT="3306"
WP_DB_NAME="tbt_legacy"
WP_DB_USER="root"
WP_DB_PASSWORD=""
WP_TABLE_PREFIX="wp_"
